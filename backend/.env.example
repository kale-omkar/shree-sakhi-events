# ==============================================================
# Shree Sakhi Events — Backend Environment Configuration Template
# Copy this file to '.env' and set your local credentials
# ==============================================================

# Server Port
SERVER_PORT=8080

# MySQL Database Connection URL
DB_URL=jdbc:mysql://localhost:3306/sakhi_events_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true

# Database Credentials
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Admin API Key (Required for Admin Event, Booking, and Enquiry management)
ADMIN_API_KEY=your_admin_key_here

# Cloudinary server-side cleanup credentials
# The API secret must never be added to frontend/.env or exposed to the browser.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==============================================================
# Enquiry & Email Notification Configuration
# ==============================================================
# All enquiry notifications must be sent to this email address
ENQUIRY_RECIPIENT_EMAIL=shreesakhi26@gmail.com

# SMTP Credentials (Required only when backend email notification service is active)
# IMPORTANT: Never commit actual passwords or app passwords to version control.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_app_password_here
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true

# Safety switch: Set to false during development tests to prevent sending real emails
ENABLE_EMAIL_SENDING=false
