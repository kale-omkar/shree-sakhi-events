# =============================================
# Shree Sakhi Events — .gitignore
# =============================================

# ── Environment & Secrets ──────────────────────────
.env
.env.local
.env.*.local
*.env
**/.env
docs
# ── Frontend (React + Vite) ────────────────────────
frontend/node_modules/
node_modules/
frontend/dist/
dist/
dist-ssr/
frontend/.vite/
.vite/
frontend/.cache/
.cache/
frontend/coverage/
coverage/
*.local

# ── Backend (Spring Boot / Maven / Java) ───────────
backend/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
!**/test/**/*.jar
backend/.mvn/wrapper/maven-wrapper.jar
**/.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.properties
backend/.settings/
backend/.classpath
backend/.project
backend/.factorypath
backend/hs_err_pid*.log
backend/*.log
*.log
logs/

# ── Computer Vision / OpenCV & Debug Artifacts ─────
debug_*.png
debug_*.jpg
scratch_*.png
scratch_*.jpg
*-detected-*.jpg
*-detected-*.png
**/verified-detected-stalls.jpg
**/scratch/

# ── IDE & Editor Files ────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.code-workspace
.settings/
.classpath
.project
.factorypath

# ── AI Agents & Tooling ───────────────────────────
.gemini/
.antigravity/
.cursor/
.claude/
.windsurf/

# ── Node / Package Managers ────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js

# ── OS & Temporary Files ───────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
~$*
